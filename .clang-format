---
# clang-format configuration for pup
# See STYLE.md for rationale

BasedOnStyle: WebKit

# Multiline function declarations: closing paren on own line (when manually broken)
# auto foo(
#     int a,
#     int b
# ) -> Result<int>;
AlignAfterOpenBracket: BlockIndent
BinPackParameters: false
BinPackArguments: false
AllowAllParametersOfDeclarationOnNextLine: false

AlignEscapedNewlines: Left
AlignTrailingComments:
    Kind: Always
    OverEmptyLines: 0

BraceWrapping:
    AfterFunction: true
BreakBeforeBraces: Custom

BreakBeforeInheritanceComma: true
BreakConstructorInitializers: BeforeComma

IndentPPDirectives: AfterHash

InsertBraces: true
InsertNewlineAtEOF: true
LineEnding: LF

NamespaceIndentation: None

QualifierAlignment: Right

RemoveSemicolon: true

SpaceAfterTemplateKeyword: false

# C++11 project - these options are kept but won't affect code
# (requires clauses are C++20 only)
IndentRequiresClause: false
RequiresClausePosition: WithFollowing
RequiresExpressionIndentation: OuterScope
