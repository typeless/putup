include_rules

# Catch2 amalgamated (compile once)
: $(ROOT)/third_party/catch_amalgamated.cpp |> !cxx |> catch_amalgamated.o {catch}

# Test sources
: foreach test_*.cpp |> !cxx |> %B.o {test_objs}

# Link test runner (reference all library objects)
: {test_objs} {catch} $(ROOT)/hash.o $(ROOT)/lexer.o $(ROOT)/parser.o $(ROOT)/ast.o $(ROOT)/eval.o $(ROOT)/glob.o |> !link |> pup_test
