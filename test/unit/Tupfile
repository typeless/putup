include_rules

# Catch2 amalgamated
: $(ROOT)/third_party/catch_amalgamated.cpp |> !cxx_thirdparty |> catch_amalgamated.o {test_support}

# E2E test fixture
: e2e_fixture.cpp |> !cxx |> %B.o {test_support}

# Test sources (disable spurious maybe-uninitialized warnings from std::variant)
: foreach test_*.cpp |> ^ CXX %f^ $(CXX) $(CXXFLAGS) -Wno-maybe-uninitialized -c %f -o %o |> %B.o {test_objs}

# Link test runner against libpup.a
: {test_objs} {test_support} $(ROOT)/libpup.a |> !link |> pup_test
