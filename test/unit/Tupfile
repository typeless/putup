ifeq (@(TESTS),y)
include_rules

# A dedicated MSVC-style linker (@(LINKER) set) links the real MSVC CRT, which
# supplies the C++ runtime and math library — and does not understand GCC-style
# -l flags. The GCC/Clang-driver builds link libstdc++/libc++ and libm explicitly.
ifeq (@(LINKER),)
_libm = -lm
ifeq (@(CXX),clang++)
_cxxlib = -lc++
else
_cxxlib = -lstdc++
endif
else
_cxxlib =
_libm =
: $(ROOT)/src/core/new_delete.cpp |> !cxx |> new_delete.$(_obj) {test_support}
endif

# Catch2 amalgamated
: $(ROOT)/third_party/catch_amalgamated.cpp |> !cxx_thirdparty |> catch_amalgamated.$(_obj) {test_support}

# E2E test fixture
: e2e_fixture.cpp |> !cxx |> e2e_fixture.$(_obj) {test_support}

