# Tuprules.tup - Shared build rules for pup

ROOT = $(TUP_CWD)

CC = gcc
CXX = g++
AR = ar

CFLAGS = -std=c11
CFLAGS += -Wall -Wextra -Werror
CFLAGS += -I$(ROOT)/third_party
CFLAGS += -fPIC

CXXFLAGS = -std=c++20
CXXFLAGS += -Wall -Wextra -Werror -Wpedantic
CXXFLAGS += -I$(ROOT)/include
CXXFLAGS += -I$(ROOT)/third_party
CXXFLAGS += -fPIC
CXXFLAGS += -DFMT_HEADER_ONLY

ifdef DEBUG
CFLAGS += -g -O0 -fsanitize=address,undefined
CXXFLAGS += -g -O0 -fsanitize=address,undefined
LDFLAGS += -fsanitize=address,undefined
else
CFLAGS += -O2 -ffunction-sections -fdata-sections
CXXFLAGS += -O2 -DNDEBUG -ffunction-sections -fdata-sections
LDFLAGS += -Wl,--gc-sections
endif

# Compile C source to object
!cc = |> ^ CC %f^ $(CC) $(CFLAGS) -c %f -o %o |> %B.o

# Compile C++ source to object
!cxx = |> ^ CXX %f^ $(CXX) $(CXXFLAGS) -c %f -o %o |> %B.o

# Link executable
!link = |> ^ LINK %o^ $(CXX) %f -o %o $(LDFLAGS) |>

# Create static library
!ar = |> ^ AR %o^ $(AR) rcs %o %f |>
