# Linux (GCC) build configuration
CONFIG_OS_API=posix
CONFIG_OBJ_EXT=o
CONFIG_LIB_EXT=a
CONFIG_EXE_EXT=

# Toolchain
CONFIG_CC=gcc
CONFIG_CXX=g++
CONFIG_AR=ar

# Flags
CONFIG_CFLAGS=-std=c11 -Wall -Wextra -Werror -fPIC
CONFIG_CXXFLAGS=-std=c++20 -Wall -Wextra -Werror -Wpedantic -fPIC -fno-exceptions -fno-rtti
CONFIG_RELEASE_CFLAGS=-O2 -ffunction-sections -fdata-sections
CONFIG_RELEASE_CXXFLAGS=-O2 -DNDEBUG -ffunction-sections -fdata-sections
CONFIG_RELEASE_LDFLAGS=-nostdlib++ -Wl,--gc-sections

# Freestanding: the shipped binary links -nostdlib -static with our own crt0
# (src/platform/crt0-linux.cpp) — zero libc. The test binary keeps libc.
CONFIG_FREESTANDING=y

# Commands (-MD generates .d depfiles for implicit header dependency tracking)
CONFIG_CC_CMD=$(CC) $(CFLAGS) -MD -c %f -o %o
CONFIG_CC_THIRDPARTY_CMD=$(CC) $(CFLAGS) -MD -Wno-error -c %f -o %o
CONFIG_CXX_CMD=$(CXX) $(CXXFLAGS) -MD -c %f -o %o
CONFIG_CXX_THIRDPARTY_CMD=$(CXX) $(CXXFLAGS) -MD -Wno-error -c %f -o %o
CONFIG_LINK_CMD=$(CXX) %f -o %o $(LDFLAGS)
# crt0 is compiled non-LTO (its _start asm must survive intact) with the stack
# protector and builtin lowering off; the shipped binary links -nostdlib -static.
CONFIG_CXX_CRT0_CMD=$(CXX) $(CXXFLAGS) -fno-lto -fno-stack-protector -fno-builtin -MD -c %f -o %o
CONFIG_FREESTANDING_LINK_CMD=$(CXX) %f -o %o $(LDFLAGS) -nostdlib -static -no-pie
CONFIG_AR_CMD=$(AR) rcs %o %f

# Script export
CONFIG_SCRIPT_PROLOGUE=#!/bin/sh\nset -ex\ncd "$(dirname "$0")"
CONFIG_SCRIPT_RUN=(cd "%DIR" && %CMD)
CONFIG_SCRIPT_MKDIR=mkdir -p "%DIR"
CONFIG_SCRIPT_COMMENT=#

# CONFIG_LTO is not set (enable: CONFIG_LTO=y or putup -D LTO)
CONFIG_TESTS=y
CONFIG_SYS_BACKEND=linux
