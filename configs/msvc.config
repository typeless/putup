# Windows MSVC build configuration
CONFIG_OS_API=win32
CONFIG_OBJ_EXT=obj
CONFIG_LIB_EXT=lib
CONFIG_EXE_EXT=.exe

# Toolchain
CONFIG_CC=cl
CONFIG_CXX=cl
CONFIG_AR=lib
CONFIG_LINKER=link

# Flags
CONFIG_CFLAGS=/std:c11 /W4 /WX /nologo
CONFIG_CXXFLAGS=/std:c++20 /W4 /WX /nologo /EHsc /GR- /D_CRT_SECURE_NO_WARNINGS
CONFIG_RELEASE_CFLAGS=/O2 /Gy
CONFIG_RELEASE_CXXFLAGS=/O2 /DNDEBUG /Gy /Gw
CONFIG_RELEASE_LDFLAGS=/OPT:REF /OPT:ICF

# Commands (MSVC syntax)
CONFIG_CC_CMD=$(CC) $(CFLAGS) /c %f /Fo%o
CONFIG_CC_THIRDPARTY_CMD=$(CC) $(CFLAGS) /WX- /c %f /Fo%o
CONFIG_CXX_CMD=$(CXX) $(CXXFLAGS) /c %f /Fo%o
CONFIG_CXX_THIRDPARTY_CMD=$(CXX) $(CXXFLAGS) /WX- /c %f /Fo%o
CONFIG_LINK_CMD=$(LINKER) /nologo %f /OUT:%o $(LDFLAGS)
CONFIG_AR_CMD=$(AR) /nologo /OUT:%o %f

# Script export (batch for native Windows)
CONFIG_SCRIPT_PROLOGUE=@echo off\nsetlocal enabledelayedexpansion\ncd /d "%~dp0"
CONFIG_SCRIPT_RUN=pushd "%DIR" && %CMD && popd || exit /b 1
CONFIG_SCRIPT_MKDIR=if not exist "%DIR" mkdir "%DIR"
CONFIG_SCRIPT_COMMENT=rem

CONFIG_TESTS=y
