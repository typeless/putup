# Coverage build configuration (Linux/GCC + gcov)
#
# A peer of linux.config that instruments every translation unit with gcov
# counters (--coverage), disables optimization for accurate line mapping, and
# keeps -nostdlib++ so the main binary still links throw_stubs instead of
# libstdc++. Only the three RELEASE_* lines differ from linux.config — keep the
# rest in sync with it.
#
# Selected via the CONFIG env var, which configs/Tupfile reads to pick which
# $(CONFIG).config to install:
#     make coverage
#   # or by hand:
#     CONFIG=coverage putup configure -B build-coverage && CONFIG=coverage putup -B build-coverage
# NOTE: `putup configure --config configs/coverage.config` does NOT select this —
# the config-generating rule in configs/Tupfile overwrites it with the platform
# config. Use CONFIG=coverage instead.
CONFIG_OS_API=posix
CONFIG_OBJ_EXT=o
CONFIG_LIB_EXT=a
CONFIG_EXE_EXT=

# Toolchain
CONFIG_CC=gcc
CONFIG_CXX=g++
CONFIG_AR=ar

# Flags
CONFIG_CFLAGS=-std=c11 -Wall -Wextra -Werror -fPIC
CONFIG_CXXFLAGS=-std=c++20 -Wall -Wextra -Werror -Wpedantic -fPIC -fno-exceptions -fno-rtti

# Coverage instrumentation: no optimization for accurate line/branch mapping,
# --coverage adds gcov counters at compile and libgcov at link.
# -fprofile-abs-path records absolute source paths in the .gcno notes: putup
# compiles each Tupfile's sources from that directory into a sibling build tree
# (e.g. test/unit sources -> build-coverage/test/unit objects), so without it
# gcov cannot reverse-map the relative source paths and gcovr fails to resolve.
CONFIG_RELEASE_CFLAGS=-O0 -g --coverage -fprofile-abs-path
CONFIG_RELEASE_CXXFLAGS=-O0 -g --coverage -fprofile-abs-path
CONFIG_RELEASE_LDFLAGS=-nostdlib++ --coverage

# Commands (-MD generates .d depfiles for implicit header dependency tracking)
CONFIG_CC_CMD=$(CC) $(CFLAGS) -MD -c %f -o %o
CONFIG_CC_THIRDPARTY_CMD=$(CC) $(CFLAGS) -MD -Wno-error -c %f -o %o
CONFIG_CXX_CMD=$(CXX) $(CXXFLAGS) -MD -c %f -o %o
CONFIG_CXX_THIRDPARTY_CMD=$(CXX) $(CXXFLAGS) -MD -Wno-error -c %f -o %o
CONFIG_LINK_CMD=$(CXX) %f -o %o $(LDFLAGS)
CONFIG_AR_CMD=$(AR) rcs %o %f

# Script export
CONFIG_SCRIPT_PROLOGUE=#!/bin/sh\nset -ex\ncd "$(dirname "$0")"
CONFIG_SCRIPT_RUN=(cd "%DIR" && %CMD)
CONFIG_SCRIPT_MKDIR=mkdir -p "%DIR"
CONFIG_SCRIPT_COMMENT=#

CONFIG_LTO=
CONFIG_TESTS=y
CONFIG_SYS_BACKEND=linux
