# Windows x86_64 (MSVC ABI) via clang-cl + xwin, cross-compiled from Linux.
#
# clang-cl compiles and lld-link links against an xwin-splatted MSVC CRT +
# Windows SDK. The splat location is host-specific, so it is injected from the
# XWIN_SPLAT environment variable in Tuprules.tup (see `ifeq (@(XWIN),y)`) rather
# than baked into this committed config. Select with:
#     XWIN_SPLAT=~/.xwin/splat CONFIG=xwin putup configure -B build-win
CONFIG_OS_API=win32
CONFIG_OBJ_EXT=obj
CONFIG_LIB_EXT=lib
CONFIG_EXE_EXT=.exe
CONFIG_XWIN=y

# Toolchain (LLVM, MSVC-compatible drivers)
CONFIG_CC=clang-cl
CONFIG_CXX=clang-cl
CONFIG_AR=llvm-lib
CONFIG_LINKER=lld-link

# Flags. --target lets clang-cl emit MSVC-ABI code while running on a Linux host.
# NOMINMAX: MSVC <windows.h> defines min/max macros that clobber std::min/std::max.
# _ALLOW_COMPILER_AND_STL_VERSION_MISMATCH: the MSVC STL hard-asserts a minimum
#   clang version; putup is effectively freestanding (custom primitives, near-zero
#   STL use), so bypass the assert to tolerate clang/STL version skew on CI.
CONFIG_CFLAGS=--target=x86_64-pc-windows-msvc /std:c11 /W4 /WX /nologo /D_CRT_SECURE_NO_WARNINGS /DNOMINMAX
CONFIG_CXXFLAGS=--target=x86_64-pc-windows-msvc /std:c++20 /W4 /WX /nologo /EHsc /GR- /D_CRT_SECURE_NO_WARNINGS /DNOMINMAX /D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH

# Release, static CRT (/MT) so the .exe has no MSVC runtime DLL dependency.
CONFIG_RELEASE_CFLAGS=/O2 /DNDEBUG /MT
CONFIG_RELEASE_CXXFLAGS=/O2 /DNDEBUG /MT
CONFIG_RELEASE_LDFLAGS=/MANIFEST:NO /MACHINE:X64 /SUBSYSTEM:CONSOLE

# Commands (MSVC-style; no -MD depfiles — clang-cl reads -MD as "dynamic CRT")
CONFIG_CC_CMD=$(CC) $(CFLAGS) /c %f /Fo%o
CONFIG_CC_THIRDPARTY_CMD=$(CC) $(CFLAGS) /WX- /c %f /Fo%o
CONFIG_CXX_CMD=$(CXX) $(CXXFLAGS) /c %f /Fo%o
CONFIG_CXX_THIRDPARTY_CMD=$(CXX) $(CXXFLAGS) /WX- /c %f /Fo%o
CONFIG_LINK_CMD=$(LINKER) /nologo %f /OUT:%o $(LDFLAGS)
CONFIG_AR_CMD=$(AR) /nologo /OUT:%o %f

# Script export (build driver runs on Linux/sh)
CONFIG_SCRIPT_PROLOGUE=#!/bin/sh\nset -ex\ncd "$(dirname "$0")"
CONFIG_SCRIPT_RUN=(cd "%DIR" && %CMD)
CONFIG_SCRIPT_MKDIR=mkdir -p "%DIR"
CONFIG_SCRIPT_COMMENT=#

CONFIG_TESTS=y
