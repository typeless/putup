# Tuprules.tup - GCC in-tree library build (root rules)
#
# Sets project-wide variables from tup.config.
# Per-library CFLAGS and !cc live in
# gmp/Tuprules.tup, mpfr/Tuprules.tup, mpc/Tuprules.tup.

S = $(TUP_CWD)
B = $(TUP_VARIANT_OUTPUTDIR)/$(S)

CC = @(CC)
AR = @(AR)
HOSTCC = @(HOSTCC)
LIMB_BITS = @(GMP_LIMB_BITS)
NAIL_BITS = @(GMP_NAIL_BITS)

GMP_DIR = gmp
MPFR_DIR = mpfr
MPC_DIR = mpc

# Generate config.h from tup.config. Set LIB before invoking.
# Filters CONFIG_<LIB>_* entries, strips prefix, emits #define lines.
!gen-config = |> ^ GEN %o^ awk -F= -v pfx=CONFIG_$(LIB)_ \
  '/^CONFIG_/{if(index($1,pfx)==1){k=substr($1,length(pfx)+1);v=substr($0,length($1)+2);if(v!="n")print "#define " k " " (v=="y"?1:v)}}' \
  $(B)/tup.config > %o |>
