include_rules

# ============================================================
# gcc/config/i386/ — x86_64 target-specific code (GCC 15.2.0)
# ============================================================
# Objects contribute to ../../<cc1-objs> for the cc1 link.
# Source list from out_object_file, extra_objs, c_target_objs in config.gcc.

# Main target description (out_object_file = i386.o)
: i386.cc |> !cxx |> i386.o ../../<cc1-objs>

# C frontend target hooks (c_target_objs)
: i386-c.cc |> !cxx |> i386-c.o ../../<cc1-objs>

# extra_objs for i386
srcs  = x86-tune-sched.cc x86-tune-sched-bd.cc
srcs += x86-tune-sched-atom.cc x86-tune-sched-core.cc
srcs += i386-options.cc i386-builtins.cc
srcs += i386-expand.cc i386-features.cc

: foreach $(srcs) |> !cxx |> %B.o ../../<cc1-objs>

# x86_64-linux extra (config.gcc line 5928)
: gnu-property.cc |> !cxx |> gnu-property.o ../../<cc1-objs>
