CONFIG_HAVE_DECL_ABORT=1
CONFIG_HAVE_DECL_ASPRINTF=1
CONFIG_HAVE_DECL_BASENAME=1
CONFIG_HAVE_DECL_CLEARERR_UNLOCKED=1
CONFIG_HAVE_DECL_ERRNO=1
