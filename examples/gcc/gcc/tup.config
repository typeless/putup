# gcc/ - x86-64 Linux auto-host.h defines
#
# These generate auto-host.h via !gen-config.
# Cross-referenced with gcc/configure.ac output for x86_64-pc-linux-gnu.

# Type sizes (HOST_BITS_PER_* derived from these by hwint.h)
CONFIG_SIZEOF_SHORT=2
CONFIG_SIZEOF_INT=4
CONFIG_SIZEOF_LONG=8
CONFIG_SIZEOF_LONG_LONG=8
CONFIG_SIZEOF_VOID_P=8
CONFIG_SIZEOF__BOOL=1
CONFIG_INT64_T_IS_LONG=1

# Headers
