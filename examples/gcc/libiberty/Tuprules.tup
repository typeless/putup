# libiberty build rules (self-contained with ?= defaults)
#
# Composed mode: parent sets S, B, CC, AR, HOSTCC, LIBIBERTY_DIR.
# Standalone mode: ?= defaults take effect.

S ?= $(TUP_CWD)
B ?= $(TUP_VARIANT_OUTPUTDIR)/$(S)
CC ?= gcc
AR ?= ar
HOSTCC ?= gcc
LIBIBERTY_DIR ?= .

CFLAGS  = -O2 -std=gnu11
CFLAGS += -DHAVE_CONFIG_H
CFLAGS += -I$(B)/$(LIBIBERTY_DIR) -I$(S)/$(LIBIBERTY_DIR)/../include

!cc = | $(S)/$(LIBIBERTY_DIR)/<gen-headers> |> ^ CC %b^ $(CC) $(CFLAGS) -c %f -o %o |> %B.o

!gen-config = |> ^ GEN %o^ awk -F= \
  '/^CONFIG_/{k=substr($1,8);v=substr($0,length($1)+2);if(v!="n")print "#define " k " " (v=="y"?1:v)}' \
  $(B)/$(LIBIBERTY_DIR)/tup.config > %o |>
