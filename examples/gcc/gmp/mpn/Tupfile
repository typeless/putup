logops_nior_n-@(C_nior_n) = generic/logops_n.c
logops_xnor_n-@(C_xnor_n) = generic/logops_n.c
logops_xor_n-@(C_xor_n) = generic/logops_n.c

: foreach $(logops_and_n-y) | $(S)/$(GMP_DIR)/<gen-headers> |> ^ CC and_n^ $(CC) $(CFLAGS) -DOPERATION_and_n -c %f -o %o |> and_n.o ../<objs>
