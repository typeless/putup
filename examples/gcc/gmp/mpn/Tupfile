include_rules

# MPN — low-level multiprecision arithmetic (generic C, no assembly)
#
# All mpn sources are compiled with -DOPERATION_<basename>.
# Five "template" files produce multiple objects via different -DOPERATION_ values:
#   logops_n.c   → and_n andn_n ior_n iorn_n nand_n nior_n xnor_n xor_n
#   popham.c     → popcount hamdist
#   sec_aors_1.c → sec_add_1 sec_sub_1
#   sec_div.c    → sec_div_qr sec_div_r
#   sec_pi1_div.c→ sec_pi1_div_qr sec_pi1_div_r

!cc-mpn = | $(S)/gmp/<gen-headers> |> ^ CC %b^ $(CC) $(GMP_CFLAGS) -DOPERATION_%B -c %f -o %o |> %B.o <objs>

