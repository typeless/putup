# =====================================================================
# Template C rules (foo-y pattern)
#
# Each template .c is compiled with different -DOPERATION_ values.
# In generic mode all are enabled (CONFIG_C_<func>=y). In assembly
# mode, functions with .asm replacements are disabled (CONFIG_C_<func>=n).
# =====================================================================

# logops_n.c → and_n, andn_n, ior_n, iorn_n, nand_n, nior_n, xnor_n, xor_n
