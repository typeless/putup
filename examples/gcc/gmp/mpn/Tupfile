# --- Multi-function templates ---
# Each template is compiled N times with different -DOPERATION_ to produce N objects.

# logops_n.c → and_n andn_n ior_n iorn_n nand_n nior_n xnor_n xor_n
: generic/logops_n.c | $(S)/gmp/<gen-headers> |> ^ CC and_n^ $(CC) $(GMP_CFLAGS) -DOPERATION_and_n -c %f -o %o |> and_n.o <objs>
