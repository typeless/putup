CONFIG_MPFR_HAVE_SYS_TIME_H=1
CONFIG_MPFR_HAVE_SYS_TYPES_H=1
CONFIG_MPFR_HAVE_UNISTD_H=1
CONFIG_MPFR_HAVE_VA_COPY=1
CONFIG_MPFR_HAVE_WCHAR_H=1
CONFIG_MPFR_HAVE_LITTLE_ENDIAN=1
CONFIG_MPFR_PACKAGE="mpfr"
CONFIG_MPFR_PACKAGE_NAME="MPFR"
CONFIG_MPFR_PACKAGE_STRING="MPFR 4.1.0"
CONFIG_MPFR_PACKAGE_TARNAME="mpfr"
CONFIG_MPFR_PACKAGE_VERSION="4.1.0"
CONFIG_MPFR_STDC_HEADERS=1
CONFIG_MPFR_VERSION="4.1.0"

# --- MPC config.h ---

CONFIG_MPC_HAVE_INTTYPES_H=1
CONFIG_MPC_HAVE_LOCALE_H=1
CONFIG_MPC_HAVE_LOCALECONV=1
CONFIG_MPC_HAVE_MEMORY_H=1
CONFIG_MPC_HAVE_SETLOCALE=1
CONFIG_MPC_HAVE_STDINT_H=1
CONFIG_MPC_HAVE_STDLIB_H=1
CONFIG_MPC_HAVE_STRING_H=1
CONFIG_MPC_HAVE_STRINGS_H=1
CONFIG_MPC_HAVE_SYS_STAT_H=1
CONFIG_MPC_HAVE_SYS_TIME_H=1
CONFIG_MPC_HAVE_SYS_TYPES_H=1
CONFIG_MPC_HAVE_UNISTD_H=1
CONFIG_MPC_PACKAGE="mpc"
CONFIG_MPC_PACKAGE_NAME="mpc"
CONFIG_MPC_PACKAGE_STRING="mpc 1.2.1"
CONFIG_MPC_PACKAGE_TARNAME="mpc"
