# GCC Libraries - AArch64 Linux cross-compile toolchain
#
# Usage:
#   putup configure --config configs/aarch64-linux.config -S ../gcc-15.2.0 -B ../build-gcc-aarch64
#
# Per-library configs live in gmp/tup.config, mpfr/tup.config, mpc/tup.config.
# Scoped config merging combines these with the toolchain vars below.

CONFIG_CC=aarch64-linux-gnu-gcc
CONFIG_AR=aarch64-linux-gnu-ar
CONFIG_HOSTCC=gcc
