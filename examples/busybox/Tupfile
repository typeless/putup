include_rules

# Usage:
#   CONFIG=android_defconfig pup configure -B build-android
#   CONFIG=freebsd_defconfig pup configure -B build-freebsd

import CONFIG=defconfig

CONF = scripts/kconfig/conf

# Generate .config via kconfig conf
ifeq ($(CONFIG),defconfig)
: | Config.in $(B)/$(CONF) \
|> ^ GEN .config^ export srctree=`pwd` && cd $(B) && yes "" | $(CONF) -d $srctree/Config.in \
|> .config
else
: | Config.in configs/$(CONFIG) $(B)/$(CONF) \
|> ^ GEN .config^ export srctree=`pwd` && cd $(B) && yes "" | $(CONF) -D $srctree/configs/$(CONFIG) $srctree/Config.in \
|> .config
endif

# Generate autoconf.h from .config
: | .config Config.in $(B)/$(CONF) \
|> ^ GEN include/autoconf.h^ export srctree=`pwd` && cd $(B) && yes "" | $(CONF) -s $srctree/Config.in \
|> include/autoconf.h include/<gen-headers>

: .config |> ^ GEN %o^ cp %f %o |> tup.config

: | tup.config \
|> ^ GEN include/applets.h include/usage.h^ ./scripts/gen_build_files.sh .. $(TUP_VARIANT_OUTPUTDIR) \
|> include/applets.h include/usage.h include/<gen-headers>

: | tup.config \
|> ^ GEN include/bbconfigopts.h^ srctree=`pwd` && cd $(B) && $srctree/scripts/mkconfigs include/bbconfigopts.h include/bbconfigopts_bz2.h \
|> include/bbconfigopts.h include/bbconfigopts_bz2.h include/<gen-headers>

: | tup.config include/applets.h include/autoconf.h \
|> ^ GEN include/embedded_scripts.h^ export srctree=`pwd` && cd $(B) && HOSTCC=gcc CONFIG_H=include/autoconf.h APPLETS_H=include/applets.h $srctree/scripts/embedded_scripts include/embedded_scripts.h $srctree/embed $srctree/applets_sh \
|> include/embedded_scripts.h include/<gen-headers>

: | tup.config \
|> ^ GEN include/common_bufsiz.h^ srctree=`pwd` && cd $(B) && $srctree/scripts/generate_BUFSIZ.sh include/common_bufsiz.h \
|> include/common_bufsiz.h include/<gen-headers>

: | <archives> \
|> ^ LINK %o^ $(CC) -Wl,--start-group %<archives> -Wl,--end-group -o %o $(LDFLAGS) $(LIBS) \
|> busybox
