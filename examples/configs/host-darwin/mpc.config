# MPC 1.2.1 - macOS (aarch64-apple-darwin) config.h defines
#
# Identical to Linux — MPC is pure C with no platform-specific features.

CONFIG_HAVE_INTTYPES_H=1
CONFIG_HAVE_LOCALE_H=1
CONFIG_HAVE_LOCALECONV=1
CONFIG_HAVE_MEMORY_H=1
CONFIG_HAVE_SETLOCALE=1
CONFIG_HAVE_STDINT_H=1
CONFIG_HAVE_STDLIB_H=1
CONFIG_HAVE_STRING_H=1
CONFIG_HAVE_STRINGS_H=1
CONFIG_HAVE_SYS_STAT_H=1
CONFIG_HAVE_SYS_TIME_H=1
CONFIG_HAVE_SYS_TYPES_H=1
CONFIG_HAVE_UNISTD_H=1
CONFIG_PACKAGE="mpc"
CONFIG_PACKAGE_NAME="mpc"
CONFIG_PACKAGE_STRING="mpc 1.2.1"
CONFIG_PACKAGE_TARNAME="mpc"
CONFIG_PACKAGE_VERSION="1.2.1"
CONFIG_STDC_HEADERS=1
CONFIG_VERSION="1.2.1"
