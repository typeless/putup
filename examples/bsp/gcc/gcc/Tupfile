# --- Multi-output RTL generators ---
# These cd to the output dir for writing; MD paths are prefixed with $SRCDIR.

# genattrtab → 3 files
: genattrtab.cc | $(BUILD_RTL_DEPS) |> !hostcxx |> host-genattrtab.o
: host-genattrtab.o $(BUILD_RTL) $(BUILD_MD) $(BUILD_ERRORS) $(LIBIBERTY_A) |> \
  ^ LINK genattrtab^ $(HOSTCC) %f -o %o |> genattrtab
: $(MD) insn-conditions.md | genattrtab |> ^ GEN insn-attrtab^ \
  SRCDIR=$PWD && cd $(TUP_VARIANT_OUTPUTDIR) && \
  MD_ARGS=""; for m in $(MD); do MD_ARGS="$MD_ARGS $SRCDIR/$m"; done && \
  ./genattrtab $MD_ARGS insn-conditions.md \
  -Ainsn-attrtab.cc -Dinsn-dfatab.cc -Linsn-latencytab.cc \
  |> insn-attrtab.cc insn-dfatab.cc insn-latencytab.cc

