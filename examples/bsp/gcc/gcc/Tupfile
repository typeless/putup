: gcov-dump.cc |> !cxx |> gcov-dump.o <gcov-dump-objs>

: <gcov-dump-objs> $(DRIVER_LIBS) \
  | <cc1-objs> <xgcc-objs> |> ^ LINK gcov-dump^ sh -c '$(CXX) %<gcov-dump-objs> \
