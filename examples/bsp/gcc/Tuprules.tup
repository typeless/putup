# gcc group rules — ?= defaults for standalone use.
# In BSP mode, root Tuprules.tup overrides these with gcc/ prefix.

S ?= $(TUP_CWD)
B ?= $(TUP_VARIANT_OUTPUTDIR)/$(S)

CC ?= @(CC)
CXX ?= @(CXX)
AR ?= @(AR)
HOSTCC ?= @(HOSTCC)

GCC_DIR ?= gcc
GMP_DIR ?= gmp
MPFR_DIR ?= mpfr
MPC_DIR ?= mpc
LIBIBERTY_DIR ?= libiberty
LIBCPP_DIR ?= libcpp
LIBDECNUMBER_DIR ?= libdecnumber
LIBBACKTRACE_DIR ?= libbacktrace
LIBCODY_DIR ?= libcody
