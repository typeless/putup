srcs-y += src/core/id_bitset.cpp
srcs-y += src/core/layout.cpp
srcs-y += src/core/metrics.cpp
srcs-y += src/core/path.cpp
srcs-y += src/core/path_pool.cpp
srcs-y += src/core/result.cpp
srcs-y += src/core/global_pool.cpp
srcs-y += src/core/buf.cpp
srcs-y += src/core/heap_buf.cpp
srcs-y += src/core/path_utils.cpp
srcs-y += src/core/sorted_id_vec.cpp
srcs-y += src/core/string_pool.cpp
srcs-y += src/core/string_utils.cpp
srcs-y += src/core/terminal.cpp

# Parser
srcs-y += src/parser/ast.cpp
srcs-y += src/parser/config.cpp
srcs-y += src/parser/depfile.cpp
srcs-y += src/parser/eval.cpp
srcs-y += src/parser/glob.cpp
srcs-y += src/parser/ignore.cpp
srcs-y += src/parser/lexer.cpp
srcs-y += src/parser/parser.cpp
srcs-y += src/parser/var_tracking.cpp

# Graph
srcs-y += src/graph/builder.cpp
srcs-y += src/graph/dag.cpp
srcs-y += src/graph/dep_scanner.cpp
srcs-y += src/graph/rule_pattern.cpp
srcs-y += src/graph/scanners/gcc.cpp
srcs-y += src/graph/topo.cpp

# Index
srcs-y += src/index/entry.cpp
srcs-y += src/index/reader.cpp
srcs-y += src/index/writer.cpp

# Exec
srcs-y += src/exec/progress_display.cpp
srcs-y += src/exec/runner.cpp
srcs-y += src/exec/scheduler.cpp

# CLI
srcs-y += src/cli/cmd_build.cpp
srcs-y += src/cli/cmd_clean.cpp
srcs-y += src/cli/cmd_configure.cpp
srcs-y += src/cli/cmd_show.cpp
srcs-y += src/cli/cmd_parse.cpp
srcs-y += src/cli/config_commands.cpp
srcs-y += src/cli/context.cpp
srcs-y += src/cli/multi_variant.cpp
srcs-y += src/cli/options.cpp
srcs-y += src/cli/output.cpp
