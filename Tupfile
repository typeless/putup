include_rules

# Third-party
: third_party/sha256/sha256.c |> !cc |> sha256.o {lib_objs}

# Library sources
: foreach src/core/*.cpp |> !cxx |> %B.o {lib_objs}
: foreach src/parser/*.cpp |> !cxx |> %B.o {lib_objs}
: foreach src/graph/*.cpp |> !cxx |> %B.o {lib_objs}
: foreach src/index/*.cpp |> !cxx |> %B.o {lib_objs}
: foreach src/exec/*.cpp |> !cxx |> %B.o {lib_objs}
: foreach src/cli/*.cpp |> !cxx |> %B.o {lib_objs}

# Platform-specific sources
: src/platform/process-$(PLATFORM).cpp |> !cxx |> %B.o {lib_objs}
: src/platform/file_io-$(PLATFORM).cpp |> !cxx |> %B.o {lib_objs}
: src/platform/env-$(PLATFORM).cpp |> !cxx |> %B.o {lib_objs}

# Static library for test linking
: {lib_objs} |> !ar |> libpup.a

# Main executable
: foreach src/*.cpp |> !cxx |> %B.o {main_objs}
: {lib_objs} {main_objs} |> !link |> pup
