include_rules

# Third-party C sources
: third_party/sha256/sha256.c |> !cc |> sha256.o {third_party_objs}

# Core library sources
: foreach src/core/*.cpp |> !cxx |> %B.o {core_objs}

# Parser library sources
: foreach src/parser/*.cpp |> !cxx |> %B.o {parser_objs}

# Graph library sources
: foreach src/graph/*.cpp |> !cxx |> %B.o {graph_objs}

# Index library sources
: foreach src/index/*.cpp |> !cxx |> %B.o {index_objs}

# Exec library sources
: foreach src/exec/*.cpp |> !cxx |> %B.o {exec_objs}

# Platform library sources (uses @(PLATFORM) config variable for platform-specific code)
: src/platform/process-$(PLATFORM).cpp |> !cxx |> process-$(PLATFORM).o {platform_objs}
: src/platform/file_io-$(PLATFORM).cpp |> !cxx |> file_io-$(PLATFORM).o {platform_objs}

# CLI library sources
: foreach src/cli/*.cpp |> !cxx |> %B.o {cli_objs}

# Build pup executable
: foreach src/*.cpp |> !cxx |> %B.o {main_objs}
: {third_party_objs} {core_objs} {parser_objs} {graph_objs} {index_objs} {exec_objs} {platform_objs} {cli_objs} {main_objs} |> !link |> pup
