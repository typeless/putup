srcs-y += src/pup/cli/cmd_show.cpp
srcs-y += src/pup/cli/cmd_parse.cpp
srcs-y += src/pup/cli/config_commands.cpp
srcs-y += src/pup/cli/context.cpp
srcs-y += src/pup/cli/multi_variant.cpp
srcs-y += src/pup/cli/options.cpp
srcs-y += src/pup/cli/output.cpp
srcs-y += src/pup/cli/strict_checks.cpp
