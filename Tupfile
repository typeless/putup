# Platform
ifeq ($(_os_api),posix)
srcs-y += src/pup/platform/sys-$(_sys_backend).cpp
srcs-y += src/pup/platform/sys-common.cpp
endif
srcs-y += src/pup/platform/process-$(_os_api).cpp
srcs-y += src/pup/platform/file_io-$(_os_api).cpp
srcs-y += src/pup/platform/env-$(_os_api).cpp
srcs-y += src/pup/platform/stream-$(_os_api).cpp
srcs-y += src/pup/platform/vm-$(_os_api).cpp

# Compile (third-party C without -Werror)
: foreach $(c-srcs-y) |> !cc_thirdparty |> {lib_objs}
: foreach $(srcs-y) |> !cxx |> {lib_objs}

# Static library
: {lib_objs} |> !ar |> libputup.$(_lib)

# Main executable (throw_stubs linked directly, not in library — avoids
# duplicate symbols when test binary links both libputup.a and libstdc++)
: src/pup/main.cpp |> !cxx |> main.$(_obj)

# A dedicated MSVC-style linker (@(LINKER) = link/lld-link, set only by the MSVC
# and clang-cl+xwin configs) links the real MSVC CRT, which already provides
# operator new/delete and the C++ ABI — so throw_stubs would duplicate them. The
# GCC/Clang-driver builds (@(LINKER) empty, -nostdlib++) have no libstdc++, so
# they need throw_stubs to supply those symbols.
ifeq (@(LINKER),)
: src/pup/core/throw_stubs.cpp |> !cxx |> throw_stubs.$(_obj)
ifeq (@(FREESTANDING),y)
: src/pup/platform/crt0-linux.cpp |> ^ CXX %f^ @(CXX_CRT0_CMD) |> crt0-linux.$(_obj)
: {lib_objs} main.$(_obj) throw_stubs.$(_obj) crt0-linux.$(_obj) |> ^ LINK %o^ @(FREESTANDING_LINK_CMD) |> putup$(_exe)
else
: {lib_objs} main.$(_obj) throw_stubs.$(_obj) |> !link |> putup$(_exe)
endif
else
: src/pup/core/new_delete.cpp |> !cxx |> new_delete.$(_obj)
: {lib_objs} main.$(_obj) new_delete.$(_obj) |> !link |> putup$(_exe)
endif
